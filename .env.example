# Скопируйте в .env и подставьте свои значения. .env в git не попадает.

# Токен от @BotFather — единственное, без чего бот не запустится.
MISGE_BOT_TOKEN=

# Контакт в User-Agent запросов к mis.ge, чтобы админам сайта было куда написать.
MISGE_CONTACT=https://t.me/your_bot

# Город по умолчанию для нового пользователя. 0 — вся Грузия, 1 — Тбилиси.
MISGE_DEFAULT_CITY=1

# DEBUG пишет в лог тексты запросов пользователей — только для отладки.
MISGE_LOG_LEVEL=INFO

# Кому отвечает /stats. Свой telegram id можно спросить у @userinfobot.
# Пусто — команда молчит для всех.
MISGE_ADMIN_ID=
